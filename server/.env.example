# === Environment ===
NODE_ENV=development
PORT=3000

# === Supabase (required) ===
# Get these from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://[your-project].supabase.co
SUPABASE_SECRET_KEY=[service_role_key]

# === Auth ===
JWT_SECRET=replace-with-a-long-random-production-secret

# === CORS ===
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# === AI (optional — falls back to heuristic if unset) ===
# Primary model config (OpenAI-compatible API). Leave unset to fall back to heuristic search.
# MODEL_ID=gpt-5.4-nano            # e.g. gpt-5.4-nano, gpt-5.4-mini, gpt-4o-mini, or any OpenAI-compatible model
# MODEL_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint (strip trailing slash)
# MODEL_API_KEY=your-openai-key
# Optional legacy keys (still supported):
# GEMINI_API_KEY=your-google-gemini-key
# OPENAI_API_KEY=your-openai-key
# AI_VISION_MODEL=gpt-4o-mini
# Embeddings for pgvector hybrid search (optional):
# AI_EMBEDDING_MODEL=text-embedding-3-small
# AI_EMBEDDING_DIM=1536
